{
  "expo": {
    "name": "Thủ tục Hành chính",
    "slug": "thu-tuc-hanh-chinh",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1d4ed8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.vngcloud.thutuchanchinh"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1d4ed8"
      },
      "package": "vn.vngcloud.thutuchanchinh"
    },
    "plugins": [
      "expo-router"
    ],
    "newArchEnabled": true,
    "scheme": "thutuc",
    "web": {
      "bundler": "metro"
    }
  }
}
